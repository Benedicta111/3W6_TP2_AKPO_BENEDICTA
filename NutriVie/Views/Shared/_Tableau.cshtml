@model NutriVie.ViewModel.RecetteCategorieVm

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Nom de la recette</th>
            <th>Nombre d'ingrédients</th>
            <th>Temps total (min)</th>
            <th>Statut</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var recette in Model.Recettes)
        {
            <partial name="_Rangee" model="recette" />
        }
    </tbody>
</table>