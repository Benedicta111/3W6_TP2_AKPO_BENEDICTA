@model List<NutriVie.ViewModel.RecetteCategorieVm>

<div class="container p-3">
    <div class="row pt-4">
        <div class="col-10">
            <h1> Recettes</h1>
        </div>
    </div>

    <div class="accordion" id="recetteAccordion">

        @foreach (var categorie in Model)
        {
            <div class="accordion-item">

                <h2 class="accordion-header">
                    <button class="accordion-button collapsed"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="@("#Id" + categorie.Id)"
                            aria-expanded="false">

                        @categorie.Nom

                    </button>
                </h2>

                <div id="@("Id" + categorie.Id)"
                     class="accordion-collapse collapse"
                     data-bs-parent="#recetteAccordion">

                    <div class="accordion-body">

                        <partial name="_Tableau" model="categorie" />

                    </div>
                </div>

            </div>
        }

    </div>
</div>